# Rust
/target
**/*.rs.bk
*.pdb

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Per-user Cargo configuration. The repository intentionally does not commit
# .cargo/config.toml so that Windows MSYS2/MINGW64 users can set their local
# target/linker without breaking Linux/macOS/CI builds.
.cargo/

# Standalone comparison runner (ocas-tests/scripts/symbolica_runner): its
# workspace is deliberately excluded from the root workspace, so its target/
# and Cargo.lock (which pins the source-available symbolica dependency) are
# local-only and not committed.
ocas-tests/scripts/symbolica_runner/target/
ocas-tests/scripts/symbolica_runner/Cargo.lock

# Python bindings build artifacts
*.so
*.pyd
*.egg-info/
dist/
build/
__pycache__/
*.py[cod]
.venv/

# uv lock files for test/bench virtual environments (not the published package)
ocas-py/uv.lock

# C/C++ bindings build artifacts
*.a
*.lib
*.dll
*.dylib
*.o
*.obj

# Documentation build
target/doc/
docs/book/html/
docs/book/en/book/
docs/book/zh/book/

# OS
.DS_Store
Thumbs.db

# Rubi corpus and benchmark artifacts (fetched by
# ocas-tests/scripts/fetch_rubi_corpus.py; never committed)
ocas-tests/data/

# Test artifacts
*.profraw
coverage/

# Node.js dev tooling artifacts (local YAML validation, etc.)
node_modules/
package-lock.json

# AI assistant context (repository-local, not shared)
CLAUDE.md

.venv-sympy/
ci_log.txt
